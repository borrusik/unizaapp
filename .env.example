# Generate a long random value and configure the same secret in local and production environments.
# Used only to encrypt saved UNIZA credentials in an authenticated HttpOnly cookie.
UNIZA_SESSION_SECRET=replace-with-at-least-32-random-characters

# Mutating integrations fail closed when these variables are absent.
# Enable them in Vercel only after the read-only flows and confirmation dialogs are verified.
ENABLE_WEBKREDIT_ACTIONS=false
ENABLE_AIVS_EXAM_ACTIONS=false
